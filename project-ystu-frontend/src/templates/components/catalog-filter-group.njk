{% macro filterGroup(group) %}
<div class="catalog-filter-group">
  {% if group.titleTag == "p" %}<p class="catalog-filter-group__title">{{ group.title }}</p>{% else %}<div class="catalog-filter-group__title">{{ group.title }}</div>{% endif %}
  <div class="catalog-filter-group__options">
    {% for option in group.options %}
    <label class="catalog-filter-option"><input type="{{ option.type }}" name="{{ option.name }}" value="{{ option.value }}"{% if option.checked %} checked{% endif %}>{{ option.text }}</label>
    {% endfor %}
  </div>
</div>
{% endmacro %}
