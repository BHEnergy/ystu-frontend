{% macro trainingCard(program) %}
<article class="training-program-card" data-ui="training-program-card"{% if program.category %} data-category="{{ program.category }}"{% endif %}>
  <div class="training-program-card__body">
    <div class="training-program-card__header"><p class="training-program-card__code">{{ program.code }}</p><span class="{{ program.tagClasses }}" data-ui="training-program-card__tag">{{ program.level }}</span></div>
    <h3>{% if program.href %}<a href="{{ program.href }}">{{ program.titleHtml | safe }}</a>{% else %}{{ program.titleHtml | safe }}{% endif %}</h3>
  </div>
  <div class="training-program-card__footer">{% for value in program.footer %}<div class="training-program-card__footer-item">{{ value }}</div>{% endfor %}</div>
</article>
{% endmacro %}
