{% macro projectCard(project) %}
<a draggable="false" href="{{ project.href }}" class="flagship-project__card">
  <p class="flagship-project__title">{{ project.titleHtml | safe }}</p>
  {% if project.image %}<div class="flagship-project__photo"><img draggable="false"{% if project.image.loading %} loading="{{ project.image.loading }}"{% endif %}{% if project.image.decoding %} decoding="{{ project.image.decoding }}"{% endif %} src="{{ project.image.src }}" alt="{{ project.image.alt }}"></div>{% endif %}
</a>
{% endmacro %}
