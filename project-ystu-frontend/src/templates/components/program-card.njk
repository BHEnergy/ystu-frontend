{% macro programCard(card) %}
<article class="{{ card.classes }}" data-ui="program-card" data-catalog-filters="{{ card.filters | dump }}">
  <div class="program-card__tags">
    {% for tag in card.tags %}<span class="{{ tag.classes }}">{{ tag.text }}</span>{% endfor %}
  </div>
  <div class="program-card__content">
    <div class="program-card__body">
      <div class="program-card__heading">
        <p class="program-card__code">{{ card.code }}</p>
        <h2 class="program-card__title"><a href="{{ card.href }}">{{ card.title }}</a></h2>
      </div>
    </div>
    <div class="program-card__profiles">
      <p class="program-card__profiles-title">{{ card.profilesTitle }}</p>
      <ul class="program-card__profiles-list">{% for profile in card.profiles %}<li>{{ profile }}</li>{% endfor %}</ul>
    </div>
  </div>
  <dl class="program-card__stats">
    {% for stat in card.stats %}<div class="program-card__stat"><dt>{{ stat.label }}</dt><dd>{{ stat.value }}</dd></div>{% endfor %}
  </dl>
</article>
{% endmacro %}
