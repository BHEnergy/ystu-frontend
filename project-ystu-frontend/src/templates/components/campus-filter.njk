{% macro campusFilter(filter) %}
<details class="{{ filter.classes }}" data-campus-filter="{{ filter.type }}">
  <summary><span data-campus-filter-label>{{ filter.label }}</span><span class="campus-filter__icon" aria-hidden="true"></span></summary>
  <div class="{{ filter.panelClasses }}">
    {% for item in filter.items %}{% if item.type == "p" %}<p class="campus-filter__group-title">{{ item.contentHtml | safe }}</p>{% else %}<button type="button" data-filter-value="{{ item.value }}">{{ item.contentHtml | safe }}</button>{% endif %}{% endfor %}
  </div>
</details>
{% endmacro %}
