{% macro vacancyCard(card) %}
<article class="vacancy-card" data-ui="vacancy-card" data-catalog-filters="{{ card.filters | dump }}">
  <img class="vacancy-card__pattern" src="{{ card.pattern.src }}" alt="{{ card.pattern.alt }}">
  <div class="vacancy-card__content">
    <div class="vacancy-card__heading"><h2 class="vacancy-card__title">{{ card.title }}</h2><p class="vacancy-card__category">{{ card.category }}</p></div>
    <p class="vacancy-card__description">{{ card.description }}</p>
    <a class="{{ card.button.classes }}" href="{{ card.button.href }}">{{ card.button.label }}</a>
  </div>
</article>
{% endmacro %}
