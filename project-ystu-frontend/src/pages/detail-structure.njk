                class="structure-gallery"
                aria-labelledby="structure-gallery-title"
              >
                <h3 id="structure-gallery-title">Галерея</h3>
                {% include "components/structure-gallery.njk" %}
              </section>
            </section>

            <section
              class="structure-detail__section"
              aria-labelledby="management-title"
            >
              <h2 class="structure-detail__section-title" id="management-title">
                Руководство
              </h2>
              {% include "components/structure-person-card.njk" %}
