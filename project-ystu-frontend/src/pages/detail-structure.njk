                <button class="btn structure-detail__tab" type="button">
                  Магистратура
                </button>
              </div>
              <div class="training-programs">
                <article class="training-program-card">
                  <div class="training-program-card__body">
                    <div class="training-program-card__header">
                      <p class="training-program-card__code">09.03.01</p>
                      <span class = "training-program-card__tag bakalavr">Бакалавриат</span>
                    </div>
                    <h3><a href="program.html">Информатика и вычислительная техника</a></h3>
                  </div>
                  <div class = "training-program-card__footer">
                    <div class = "training-program-card__footer-item">
                      Очно
                    </div>
                    <div class = "training-program-card__footer-item">
                      20 бюджетных мест
                    </div>
                    <div class = "training-program-card__footer-item">
                      40 платных мест
                    </div>
                  </div>
                </article>
                <article class="training-program-card">
                  <div class="training-program-card__body">
                    <div class="training-program-card__header">
                      <p class="training-program-card__code">09.03.02</p>
                      <span class = "training-program-card__tag bakalavr">Бакалавриат</span>
                    </div>
                    <h3><a href="program.html">Информационные системы и технологии</a></h3>
                  </div>
                  <div class = "training-program-card__footer">
                    <div class = "training-program-card__footer-item">
                      Очно
                    </div>
                    <div class = "training-program-card__footer-item">
                      20 бюджетных мест
                    </div>
                  </div>
                </article>
                <article class="training-program-card">
                  <div class="training-program-card__body">
                    <div class="training-program-card__header">
                      <p class="training-program-card__code">09.03.03</p>
                      <span class = "training-program-card__tag magistratura">Магистратура</span>
                    </div>
                    <h3><a href="program.html">Прикладная информатика</a></h3>
                  </div>
                  <div class = "training-program-card__footer">
                    <div class = "training-program-card__footer-item">
                      Очно
                    </div>
