{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Детальная страница университета | ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %} class = "detail-structure"{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Хлебные крошки">
            <a class="breadcrumbs__item" href="index.html">Главная</a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="#">Университет</a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="index.html"
              >Структура университета</a
            >
            <div class="breadcrumbs__separator"></div>
            <span>Институт цифровых систем</span>
          </nav>
        </div>

        <div class="container">
          <article class="structure-detail">
            <section class="structure-detail__intro">
              <h1 class="structure-detail__title">Институт цифровых систем</h1>
