                  </div>
                  <div class = "training-program-card__footer">
                    <div class = "training-program-card__footer-item">
                      Очно
                    </div>
                    <div class = "training-program-card__footer-item">
                      20 бюджетных мест
                    </div>
                    <div class = "training-program-card__footer-item">
                      40 платных мест
                    </div>
                  </div>
                </article>
              </div>
            </section>

            <section
              class="structure-detail__section structure-about"
              aria-labelledby="about-institute-title"
            >
              <h2
                class="structure-detail__section-title"
