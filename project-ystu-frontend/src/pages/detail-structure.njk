                      20 бюджетных мест
                    </div>
                    <div class = "training-program-card__footer-item">
                      40 платных мест
                    </div>
                  </div>
                </article>
                <article class="training-program-card">
                  <div class="training-program-card__body">
                    <div class="training-program-card__header">
                      <p class="training-program-card__code">09.04.01</p>
                      <span class = "training-program-card__tag magistratura">Магистратура</span>
                    </div>
