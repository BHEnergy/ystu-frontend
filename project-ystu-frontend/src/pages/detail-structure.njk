              {% include "components/structure-employees.njk" %}
            </section>

            <section
              class="vacancy-documents structure-detail__documents"
              aria-labelledby="structure-documents-title"
            >
              <h2
                class="vacancy-documents__title"
                id="structure-documents-title"
              >
                Документы
              </h2>
              {% include "components/document-list.njk" %}
            </section>
          </article>
        </div>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
