{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src = "../js/main.js" type="text/javascript"></script>
    <title>Главная страница</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/information-banner.njk" %}
      {% include "components/header.njk" %}
      <main class="main">
          <!-- Слайдер -->
          <section>
            <div class="container">
            {% set heroHeadingTag = "h1" %}{% include "components/hero-slider.njk" %}
          </div>
          </section>

          <!-- Фичеры -->
          <section>
          <div class="container">
            {% include "components/fichers.njk" %}
          </div>
          </section>

          <!-- События / новости -->
          <section>
          <div class = "container">
            <div class="events">
              <div class="events__wrapper" data-ui="events__wrapper">
                <div class="events__header events__header--fade" data-ui="events__header--fade" role="group" aria-label="Новости и события">
                    <button type="button" class="title events__title active tab" data-ui="tab" data-value="tab" data-tab="events" aria-pressed="true">События</button>
                    <div class="events__separator"></div>
                    <button type="button" class="title events__title unactive tab" data-ui="tab" data-value="tab" data-tab="news" aria-pressed="false">Новости</button>
                </div>
                <div class = "events__container active" data-ui="events__container" data-value="tab-container" data-tab="events">
                  <div class = "events__content " data-ui="events__content">
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-1"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-2"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-3"]) }}
                    </div>
                    <a class = "btn btn--default btn--m" href = "news-events.html">
                      Все события
                    </a>
                </div>
                <div class = "events__container unactive" data-ui="events__container" data-value="tab-container" data-tab="news">
                  <div class = "events__content" data-ui="events__content">
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-1"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-2"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-3"]) }}
                    </div>
                    <a class = "btn btn--default btn--m" href = "news-events.html">
                      Все новости
                    </a>
                </div>
              </div>
            </div>
          </div>
          </section>

          <!-- Флагманские проекты -->
          <section class="flagship-projects">
          <div class = "container">
            <h2 class="flagship-projects__title">Флагманские проекты</h2>

            {% include "components/flagship-grid.njk" %}
          </div>
          </section>

          <!-- ЯГТУ в цифрах -->
          {% include "components/university-statistics.njk" %}

          <!-- CTA -->
          <section>
          <div class = "container">
          {% include "components/preparatory-courses.njk" %}
          </div>
          </section>

          <!-- Слайдер в низу -->
          <section class = "banner-slider">
            <div class = "container">
              <div class = "swiper js-init-banner-slider banner-slider-3 banner-slider-3--featured default-slider" data-slider-kind="3" data-pagination="bullets">
                {% include "components/banner-featured-slides.njk" %}
                {% include "components/default-slider-controls.njk" %}
              </div>
            </div>
          </section>
      </main>
      {% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
      {% include "components/event-modal.njk" %}
  {% endblock %}
