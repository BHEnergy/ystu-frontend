{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src = "../js/main.js" type="text/javascript"></script>
    <title>Главная страница</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/information-banner.njk" %}
      {% include "components/header.njk" %}
      <main class="main">
          <!-- Слайдер -->
          <section>
            <div class="container">
            {% include "components/hero-slider.njk" %}
          </div>
          </section>

          <!-- Фичеры -->
          <section>
          <div class="container">
            {% include "components/fichers.njk" %}
          </div>
          </section>

          <!-- События / новости -->
          <section>
          <div class = "container">
            <div class="events">
              <div class="events__wrapper">
                <div class="events__header events__header--fade" role="group" aria-label="Новости и события">
                    <button type="button" class="title events__title active tab" data-value="tab" data-tab="events" aria-pressed="true">События</button>
                    <div class="events__separator"></div>
                    <button type="button" class="title events__title unactive tab" data-value="tab" data-tab="news" aria-pressed="false">Новости</button>
                </div>
                <div class = "events__container active" data-value="tab-container" data-tab="events">
                  <div class = "events__content ">
                        <div class="event__card">
                            <div class = "event__photo">
                                <img loading="lazy" decoding="async" src = "../images/fallback/banner1.png" alt="Выступление с презентацией анализа 3D-сканов деталей">
                            </div>
                            <div class = "event__content">
                                <p class = "event__title">Международная научно-практическая конференция «Экологическая безопасность водных объектов»</p>
                                <div class = "event__body">
                                    <div class = "event__info">
                                        <p class = "event__date">1-3 июля 2026</p>
                                        <p class = "event__time">с 11:00 до 16:00</p>
                                        <p class = "event__location">Точка кипения</p>
                                    </div>
                                    <div class = "event__footer">
                                        <button type="button" class="btn btn--link btn--blue button-modal" data-modal="event">Зарегистрироваться</button>
                                        <a class = "btn btn--link btn--white" href = "news-events.html">Подробнее</a>
                                    </div>
                                </div>
                            </div>
                            <div class="event__tags">
                              <div class = "event__tag">
                                10-11 класс
                              </div>
                              <div class = "event__tag">
                                Онлайн
                              </div>
                            </div>
                        </div>
                        <div class="event__card">
                            <div class = "event__photo">
                                <img loading="lazy" decoding="async" src = "../images/fallback/banner1.png" alt="Выступление с презентацией анализа 3D-сканов деталей">
                            </div>
                            <div class = "event__content">
                                <p class = "event__title">Исторический квиз "Я помню! Я горжусь!"</p>
                                <div class = "event__body">
                                    <div class = "event__info">
                                        <p class = "event__date">1-3 июля 2026</p>
                                        <p class = "event__time">с 11:00 до 16:00</p>
                                        <p class = "event__location">Точка кипения</p>
                                    </div>
                                    <div class = "event__footer">
                                        <button type="button" class="btn btn--link btn--blue button-modal" data-modal="event">Зарегистрироваться</button>
                                        <a class = "btn btn--link btn--white" href = "news-events.html">Подробнее</a>
                                    </div>
                                </div>
                            </div>
                            <div class="event__tags">
                              <div class = "event__tag">
                                10-11 класс
                              </div>
                              <div class = "event__tag">
                                Онлайн
                              </div>
                            </div>
                        </div>
                        <div class="event__card">
                            <div class = "event__photo">
                                <img loading="lazy" decoding="async" src = "../images/fallback/banner1.png" alt="Выступление с презентацией анализа 3D-сканов деталей">
                            </div>
                            <div class = "event__content">
                                <p class = "event__title">Акселератор «ПолиТех.Индустрия 5.0»</p>
                                <div class = "event__body">
                                    <div class = "event__info">
                                        <p class = "event__date">1-3 июля 2026</p>
                                        <p class = "event__time">с 11:00 до 16:00</p>
                                        <p class = "event__location">Точка кипения</p>
                                    </div>
                                    <div class = "event__footer">
                                        <button type="button" class="btn btn--link btn--blue button-modal" data-modal="event">Зарегистрироваться</button>
                                        <a class = "btn btn--link btn--white" href = "news-events.html">Подробнее</a>
                                    </div>
                                </div>
                            </div>
                            <div class="event__tags">
                              <div class = "event__tag">
                                10-11 класс
                              </div>
                              <div class = "event__tag">
                                Онлайн
                              </div>
                            </div>
                        </div>
                    </div>
                    <a class = "btn btn--default btn--m" href = "news-events.html">
                      Все события
                    </a>
                </div>
                <div class = "events__container unactive" data-value="tab-container" data-tab="news">
                  <div class = "events__content">
<a class="news__card" href="#">
                            <div class = "news__photo">
                              <img loading="lazy" decoding="async" src = "../images/fallback/banner-news.png" alt="Студенты с табличкой Ярославского государственного технического университета">
                            </div>
                            <div class = "news__content">
                              <div class = "news__header">
                                  <p class = "news__date">26.02.2026</p>
                                  <p class = "news__title">Международная научно-практическая конференция «Экологическая безопасность водных объектов»</p>
                              </div>
                              <div class = "news__tags">
                                  <p class = "news__tag">приемная кампания</p>
                                  <p class = "news__tag">поступающим</p>
                              </div>
                            </div>
                        </a>
<a class="news__card" href="#">
                            <div class = "news__photo">
                              <img loading="lazy" decoding="async" src = "../images/fallback/banner-news.png" alt="Студенты с табличкой Ярославского государственного технического университета">
                            </div>
                            <div class = "news__content">
                              <div class = "news__header">
                                  <p class = "news__date">26.02.2026</p>
                                  <p class = "news__title">Социологическй опрос «Приоритет 2030»</p>
                              </div>
                              <div class = "news__tags">
                                  <p class = "news__tag">приемная кампания</p>
                                  <p class = "news__tag">поступающим</p>
                              </div>
                            </div>
                        </a>
<a class="news__card" href="#">
                            <div class = "news__photo">
                              <img loading="lazy" decoding="async" src = "../images/fallback/banner-news.png" alt="Студенты с табличкой Ярославского государственного технического университета">
                            </div>
                            <div class = "news__content">
                              <div class = "news__header">
                                  <p class = "news__date">26.02.2026</p>
                                  <p class = "news__title">Максим Татаров встретился <br>со студентами Института экономики и менеджмента</p>
                              </div>
                              <div class = "news__tags">
                                  <p class = "news__tag">приемная кампания</p>
                                  <p class = "news__tag">поступающим</p>
                              </div>
                            </div>
                        </a>
                    </div>
                    <a class = "btn btn--default btn--m" href = "news-events.html">
                      Все новости
                    </a>
                </div>
              </div>
            </div>
          </div>
          </section>

          <!-- Флагманские проекты -->
          <section class="flagship-projects">
          <div class = "container">
            <h2 class="flagship-projects__title">Флагманские проекты</h2>

            {% include "components/flagship-card.njk" %}
          </div>
          </section>

          <!-- ЯГТУ в цифрах -->
          {% include "components/university-statistics.njk" %}

          <!-- CTA -->
          <section>
          <div class = "container">
          {% include "components/preparatory-courses.njk" %}
          </div>
          </section>

          <!-- Слайдер в низу -->
          <section class = "banner-slider">
            <div class = "container">
              <div class = "swiper js-init-banner-slider banner-slider-3 banner-slider-3--featured default-slider" data-pagination="bullets">
                {% include "components/banner-featured-slides.njk" %}
                {% include "components/default-slider-controls.njk" %}
              </div>
            </div>
          </section>
      </main>
      {% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
      {% include "components/event-modal.njk" %}
  {% endblock %}
