{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UI-kit — ЯГТУ</title>
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js"></script>
    <style>
      /* Оформление каталога не изменяет исходные компоненты. */
      .ui-kit-page .header {
        position: relative;
        top: auto;
      }
      @media (max-width: 1100px) {
        .ui-kit-page .header--menu-open {
          position: fixed;
          top: 0;
          background: #fff;
        }
        .ui-kit-page .header--menu-open .mega-menu {
          top: var(--header-panel-height, 88px);
          height: calc(100dvh - var(--header-panel-height, 88px));
        }
      }
      .ui-kit-page .main {
        padding-top: 0;
      }
      .ui-kit__meta {
        padding-top: 28px;
        padding-bottom: 24px;
        border-top: 1px solid #ced9e7;
        color: #094188;
        scroll-margin-top: 24px;
      }
      .ui-kit__meta h2 {
        font-size: 26px;
        line-height: 1.25;
        margin: 0 0 12px;
      }
      .ui-kit__meta p {
        font-size: 16px;
        line-height: 1.5;
        margin: 6px 0;
        overflow-wrap: anywhere;
      }
      .ui-kit__meta a,
      .ui-kit__toc a {
        color: #094188;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .ui-kit__meta code {
        background: #e6ecf3;
        padding: 2px 5px;
      }
      .ui-kit__entry {
        padding-bottom: 40px;
        min-width: 0;
      }
      .ui-kit__sample {
        min-width: 0;
        display: flow-root;
      }
      .ui-kit__sample > .main-slider,
      .ui-kit__sample > .fichers,
      .ui-kit__sample > .events,
      .ui-kit__sample > .preparatory-courses,
      .ui-kit__sample > .events__tags,
      .ui-kit__sample > .vacancy-card,
      .ui-kit__sample > .vacancy-documents,
      .ui-kit__sample > .breadcrumbs {
        width: calc(100% - 48px);
        max-width: 1440px;
        margin-left: auto;
        margin-right: auto;
      }
      .ui-kit__sample .cookie-banner {
        position: static;
        transform: none;
        margin-top: 20px;
        width: fit-content;
      }
      .ui-kit__intro {
        padding-top: 32px;
        padding-bottom: 32px;
      }
      .ui-kit__intro h1 {
        font-size: 36px;
        margin-bottom: 20px;
        color: #094188;
      }
      .ui-kit__intro p {
        font-size: 18px;
        line-height: 1.5;
        margin-bottom: 20px;
      }
      .ui-kit__toc {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 10px 24px;
        list-style: none;
        padding: 0;
      }
      .ui-kit__toc a {
        font-size: 16px;
        line-height: 1.4;
      }
      @media (max-width: 767px) {
        .ui-kit__meta h2 {
          font-size: 22px;
        }
        .ui-kit__entry {
          padding-bottom: 24px;
        }
        .ui-kit__sample > .main-slider,
        .ui-kit__sample > .fichers,
        .ui-kit__sample > .events,
        .ui-kit__sample > .preparatory-courses,
        .ui-kit__sample > .events__tags,
        .ui-kit__sample > .vacancy-card,
        .ui-kit__sample > .vacancy-documents,
        .ui-kit__sample > .breadcrumbs {
          width: calc(100% - 30px);
        }
      }
    </style>
  {% endblock %}
{% block bodyAttributes %} class="ui-kit-page"{% endblock %}
{% block content %}
