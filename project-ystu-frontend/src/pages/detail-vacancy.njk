{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src = "../js/main.js" type="text/javascript"></script>
    <title>Детальная Работа в ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main detail-vacancy-page">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Хлебные крошки">
            <a class="breadcrumbs__item" href="index.html">Главная</a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="#">Университет</a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="index.html">Работа в ЯГТУ</a>
            <div class="breadcrumbs__separator"></div>
            <span>Документовед</span>
          </nav>
        </div>

        <section class = "detail-vacancy container">
          <h1 class = "h1 title">Документовед</h1>
          <div class = "detail-vacancy__body">
            {% include "components/vacancy-intro.njk" %}
            {% include "components/vacancy-conditions.njk" %}
          </div>
          {% include "components/vacancy-description.njk" %}
          <div class="vacancy-documents">
            <h2 class="vacancy-documents__title">Основные документы</h2>
            {% include "components/document-list.njk" %}
          </div>
        </section>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/vacancy-modal.njk" %}
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
