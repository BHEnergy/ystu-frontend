{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Студенческая жизнь — ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %} class = "student-life"{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}

      <main class="main main--header-overlay">
        <section class="hero-banner">
          <img
            class="hero-banner__image"
            src="../images/fallback/student-life-hero.png"
            alt="Студенты в пространстве для совместной работы"
          />
          <div class="container">
            <div class="breadcrumbs">
              <a class="breadcrumbs__item" href="index.html">Главная</a>
              <div class="breadcrumbs__separator"></div>
              <span>Студенческая жизнь</span>
            </div>
            <div class="hero-banner__content hero-banner__content--student">
              <h1 class="hero-banner__title h1">
                Студенческая жизнь
              </h1>
            </div>
          </div>
        </section>

        <section class="feature-sections container">
            <h2 class="title feature-sections__title">Направления</h2>
            <div class="feature-sections__list">
{% from "components/feature-section.njk" import featureSection %}
{{ featureSection(componentExamples.features["features-1"]) }}

{% from "components/feature-section.njk" import featureSection %}
{{ featureSection(componentExamples.features["features-2"]) }}

{% from "components/feature-section.njk" import featureSection %}
{{ featureSection(componentExamples.features["features-3"]) }}

{% from "components/feature-section.njk" import featureSection %}
{{ featureSection(componentExamples.features["features-4"]) }}

{% from "components/feature-section.njk" import featureSection %}
{{ featureSection(componentExamples.features["features-5"]) }}
            </div>
        </section>

        <section class="student-courses">
          <div class="container">
            {% include "components/preparatory-courses.njk" %}
          </div>
        </section>

        {% include "components/text-media.njk" %}

{% from "components/link-cards.njk" import linkCards %}
{{ linkCards(componentExamples.linkCards["linkCards-1"]) }}

{% from "components/contact-section.njk" import contactSection %}
{{ contactSection(componentExamples.contacts["contacts-1"]) }}
      </main>

{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
