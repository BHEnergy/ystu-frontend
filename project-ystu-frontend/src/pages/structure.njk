{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src = "../js/main.js" type="text/javascript"></script>
    <title>Структура университета</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main">
        <div class = "container">
            <div class = "breadcrumbs">
                <a class = "breadcrumbs__item" href = "index.html">
                    Главная
                </a>
                <div class = "breadcrumbs__separator"></div>
                <a class = "breadcrumbs__item" href = "index.html">
                    Университет
                </a>
                <div class = "breadcrumbs__separator"></div>
                <span>Структура университета</span>
            </div>
        </div>    
        <!-- События / новости -->
        <section class = "department-directory">
          <div class = "container department-directory__container" data-ui="structure__container">
            <h1 class = "title">Структура университета</h1>
            <div class = "department-directory__tags" data-ui="structure__tags" role="group" aria-label="Раздел структуры">
              <button type="button" class="filter-tag tag select" data-filter="institutes" aria-pressed="true">
                Институты
              </button>
              <button type="button" class="filter-tag tag" data-filter="departments" aria-pressed="false">
                Кафедры
              </button>
              <button type="button" class="filter-tag tag" data-filter="buildings" aria-pressed="false">
                Корпуса и общежитие
              </button>
              <button type="button" class="filter-tag tag" data-filter="services" aria-pressed="false">
                Службы и отделы
              </button>
            </div>
            <ul class="department-directory__institutes" data-ui="structure__institutes" data-category="institutes">
{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-1"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-2"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-3"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-4"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-5"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-6"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-7"]) }}

{% from "components/department-card.njk" import departmentCard %}
{{ departmentCard(componentExamples.departments["departments-8"]) }}
              </ul>
          </div>
        </section>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
