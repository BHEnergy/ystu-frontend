{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src = "../js/main.js" type="text/javascript"></script>
    <title>Новости</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main">
        <div class = "container">
            <div class = "breadcrumbs">
                <a class = "breadcrumbs__item" href = "index.html">
                    Главная
                </a>
                <div class = "breadcrumbs__separator"></div>
                <span>Новости</span>
            </div>
        </div>    
        <!-- События / новости -->
        <section class = "events-section">
          <div class = "container">
            <h1 class="visually-hidden">Новости и события ЯГТУ</h1>
            <div class="events">
              <div class="events__wrapper" data-ui="events__wrapper">
                <div class="events__header events__header--fade" data-ui="events__header--fade" role="group" aria-label="Новости и события">
                    <button type="button" class="title events__title unactive tab" data-ui="tab" data-value="tab" data-tab="events" aria-pressed="false">События</button>
                    <div class="events__separator"></div>
                    <button type="button" class="title events__title active tab" data-ui="tab" data-value="tab" data-tab="news" aria-pressed="true">Новости</button>
                </div>
                <div class = "events__tags active" data-ui="events__tags" data-value="tab-container" data-tab="news">
                  <button type="button" class="events__tag current" data-filter="all" aria-pressed="true">Все</button>
                  <button type="button" class="events__tag" data-filter="#приемная кампания" aria-pressed="false">#приемная кампания</button>
                  <button type="button" class="events__tag" data-filter="#поступающим" aria-pressed="false">#поступающим</button>
                  <button type="button" class="events__tag" data-filter="#наука" aria-pressed="false">#наука</button>
                </div>
                <div class = "events__container unactive" data-ui="events__container" data-value="tab-container" data-tab="events" data-pagination-size="6">
                  <div class = "events__content " data-ui="events__content">
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-4"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-5"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-6"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-4"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-5"]) }}
{% from "components/event-card.njk" import eventCard %}
{{ eventCard(componentExamples.events["events-7"]) }}
                    </div>
                    <!-- Пагинация -->
                    {% include "components/demo-extra-events.njk" %}
                    {% include "components/pagination.njk" %}
                </div>
                <div class = "events__container active" data-ui="events__container" data-value="tab-container" data-tab="news" data-pagination-size="6">
                  <div class = "events__content" data-ui="events__content">
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-1"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-2"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-3"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-1"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-2"]) }}
{% from "components/news-card.njk" import newsCard %}
{{ newsCard(componentExamples.news["news-3"]) }}
                    </div>
                    <!-- Пагинация -->
                    {% include "components/demo-extra-news.njk" %}
                    {% include "components/pagination.njk" %}
                </div>
              </div>
            </div>
          </div>
          </section>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
      {% include "components/event-modal.njk" %}
  {% endblock %}
