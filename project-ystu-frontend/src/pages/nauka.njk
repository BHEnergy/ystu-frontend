{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Научные журналы ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main">
        <div class="container">
          <div class="breadcrumbs">
            <a class="breadcrumbs__item" href="index.html"> Главная </a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="index.html"> Наука и инновации </a>
            <div class="breadcrumbs__separator"></div>
            <span>Научные журналы ЯГТУ</span>
          </div>
        </div>
        <section class="science">
          <div class="science-list container d-flex flex-column">
            <h1 class="title science-list__title">Научные журналы ЯГТУ</h1>
            <div class="science-list__content d-flex flex-column">
              {% include "components/dropdown--item-3.njk" %}
              {% include "components/dropdown--item-2.njk" %}
              {% include "components/dropdown--item.njk" %}
              <div class="dropdown--item">
                <div class="science-detail dropdown--header">
                  <h2 class="science-detail__title"><button class="dropdown--trigger" type="button">«Oт химии к технологии шаг за шагом»</button></h2>
                </div>

                <div class="dropdown--content science-detail__content wyswig">
                  <section class = "science-detail__section">
                    <div class = "science-detail__content d-flex flex-row">
                      <img class = "science-detail__photo" src = "../images/fallback/journal.png" alt="Обложка научного журнала «Теоретическая экономика», № 10 (70), 2020">
                      <div class = "science-detail__info">
                        <dl>
                          <dt>Год основания</dt>
                          <dd>2020</dd>
                        </dl>
                        <dl>
                          <dt>Главный редактор</dt>
                          <dd>Федосов Сергей Викторович, доктор технических наук, академик РААСН, профессор.</dd>
                        </dl>
                        <dl>
                          <dt>Индексация</dt>
                          <dd>РИНЦ</dd>
                        </dl>
                        <dl>
                          <dt>Доступность</dt>
                          <dd>Открытый доступ, издается при финансовой поддержке Университета</dd>
                        </dl>
                        <dl>
                          <dt>Лицензия</dt>
                          <dd>Creative Commons: CC BY 4.0</dd>
                        </dl>
                        <dl>
                          <dt>Периодичность выхода</dt>
                          <dd>4 выпуска в год</dd>
                        </dl>
                        <dl>
                          <dt>Рецензирование</dt>
                          <dd>двойное слепое</dd>
                        </dl>
                        <dl>
                          <dt>Язык</dt>
                          <dd>русский, английский</dd>
                        </dl>
                        <a href = "#" class = "btn btn--default btn--sm">Подробнее</a>
                      </div>
                    </div>
                    <div class = "science-detail__description">
                      <p class = "science-detail__code">ISSN 2782-1919</p>
                      <p>Рецензируемый научно-практический журнал публикует работы преподавателей и сотрудников высших учебных заведений РФ, РАН, РААСН, других исследовательских подразделений, работающих в сфере промышленного и гражданского строительства и архитектуры, в том числе в странах стран СНГ и за рубежом. Рубрики журнала: строительные конструкции, здания и сооружения; строительные материалы и изделия; проектирование и строительство дорог, метрополитенов; архитектура зданий и сооружений; творческие концепции архитектурной деятельности.</p>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
