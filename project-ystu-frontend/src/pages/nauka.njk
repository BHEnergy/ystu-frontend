{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Научные журналы ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}
      <main class="main">
        <div class="container">
          <div class="breadcrumbs">
            <a class="breadcrumbs__item" href="index.html"> Главная </a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="index.html"> Наука и инновации </a>
            <div class="breadcrumbs__separator"></div>
            <span>Научные журналы ЯГТУ</span>
          </div>
        </div>
        <section class="science">
          <div class="journal-list container d-flex flex-column">
            <h1 class="title journal-list__title">Научные журналы ЯГТУ</h1>
            <div class="journal-list__content d-flex flex-column">
{% from "components/journal-card.njk" import journalAccordion %}
{{ journalAccordion(componentExamples.journals["journals-4"]) }}
{% from "components/journal-card.njk" import journalAccordion %}
{{ journalAccordion(componentExamples.journals["journals-3"]) }}
{% from "components/journal-card.njk" import journalAccordion %}
{{ journalAccordion(componentExamples.journals["journals-5"]) }}
{% from "components/journal-card.njk" import journalAccordion %}
{{ journalAccordion(componentExamples.journals["journals-1"]) }}
            </div>
          </div>
        </section>
      </main>
{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
