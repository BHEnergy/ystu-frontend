{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Поиск</title>
  {% endblock %}
{% block bodyAttributes %} class = "search-page-background"{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}

      <main class="main search-page">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Хлебные крошки">
            <a class="breadcrumbs__item" href="index.html">Главная</a>
            <span class="breadcrumbs__separator" aria-hidden="true"></span>
            <span aria-current="page">Поиск</span>
          </nav>
        </div>
        <section class="container search-page">
          <form class="search-page__form" action="#" method="get" role="search">
            <input
              class="search-page__input"
              id="site-search"
              name="q"
              type="search"
              aria-label="Поиск по сайту"
              placeholder="Поиск"
              autocomplete="off"
            />
            <button class="btn btn--blue btn--xl search-page__submit" type="submit">
              Найти
            </button>
          </form>
        </section>
      </main>

{% include "components/footer.njk" %}
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
