{% extends "layouts/base.njk" %}
{% block head %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../styles/styles.css?v=3" rel="stylesheet" />
    <script src="../js/main.js" type="text/javascript"></script>
    <title>Работа в ЯГТУ</title>
  {% endblock %}
{% block bodyAttributes %}{% endblock %}
{% block content %}
    <div class="wrapper">
      {% include "components/header.njk" %}

      <main class="main listing-page listing-page--vacancies">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Хлебные крошки">
            <a class="breadcrumbs__item" href="index.html">Главная</a>
            <div class="breadcrumbs__separator"></div>
            <a class="breadcrumbs__item" href="#">Университет</a>
            <div class="breadcrumbs__separator"></div>
            <span>Работа в ЯГТУ</span>
          </nav>

          <section class="listing-page__intro">
            <h1 class="listing-page__title">Работа в ЯГТУ</h1>
            <p class="listing-page__description">Lorem ipsum dolor sit amet consectetur. Eu augue fames felis ultrices. Scelerisque ipsum nulla tempor vitae. Nec eu dui feugiat orci dui amet consectetur tortor sem. In malesuada vitae urna mattis tortor aenean porttitor aenean. Lorem ipsum dolor sit amet consectetur. Eu augue fames felis ultrices. Scelerisque ipsum nulla tempor vitae. Nec eu dui feugiat orci dui amet consectetur tortor sem. In malesuada vitae urna mattis tortor aenean porttitor aenean.</p>
          </section>

          <div class="listing-page__body">
            <aside class="listing-page__sidebar">
              <h2 class="catalog-filters__title">Фильтры</h2>
              <form class="catalog-filters" method="get">
                <div class="catalog-search">
                  <p>найти направление</p>
                  <input class="catalog-search__input" name="query" type="search" aria-label="Найти вакансию" />
                  <button class="catalog-search__button" type="submit" aria-label="Найти"><img src="../images/svg/vacancy-search.svg" alt="" /></button>
                </div>
                <div class="catalog-filter-group">
                  <p class="catalog-filter-group__title">категория</p>
                  <div class="catalog-filter-group__options">
                    <label class="catalog-filter-option"><input type="checkbox" name="category[]" value="academic" />Научно-педагогические работники</label>
                    <label class="catalog-filter-option"><input type="checkbox" name="category[]" value="administrative" checked />Административный персонал</label>
                  </div>
                </div>
                {% include "components/catalog-filter-group-4.njk" %}
                <div class="catalog-filter-group">
                  <p class="catalog-filter-group__title">тип занятости</p>
                  <div class="catalog-filter-group__options">
                    <label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="full" checked />полная</label>
                    <label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="part" />частичная</label>
                    <label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="internship" />стажировка</label>
                  </div>
                </div>
                <div class="catalog-filter-group">
                  <p class="catalog-filter-group__title">формат работы</p>
                  <div class="catalog-filter-group__options">
                    <label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="office" />Офис</label>
                    <label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="hybrid" />Гибрид</label>
                    <label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="remote" />Удалённо</label>
                  </div>
                </div>
                <div class="catalog-filters__actions">
                  <button class="btn btn--default btn--m catalog-filters__apply" type="submit">Применить</button>
                  <button class="btn catalog-filters__reset" type="reset">Очистить</button>
                </div>
              </form>
            </aside>

            <section aria-label="Список вакансий">
              <div class="listing-page__mobile-tools">
                <form class="catalog-search" method="get" role="search">
                  <input class="catalog-search__input" name="query" type="search" placeholder="найти вакансию" aria-label="Найти вакансию" />
                  <button class="catalog-search__button" type="submit" aria-label="Найти"><img src="../images/svg/vacancy-search.svg" alt="" /></button>
                </form>
                <button class="catalog-filters-trigger" type="button" data-open-filter-panel="vacancy-filter-panel" aria-controls="vacancy-filter-panel" aria-expanded="false">Фильтры<img src="../images/svg/filters.svg" alt="" /></button>
              </div>
              <div class="listing-page__results">
                {% include "components/vacancy-card.njk" %}
                <article class="vacancy-card">
                  <img class="vacancy-card__pattern" src="../images/svg/vacancy-pattern.svg" alt="" />
                  <div class="vacancy-card__content"><div class="vacancy-card__heading"><h2 class="vacancy-card__title">Инженер-конструктор</h2><p class="vacancy-card__category">Административный персонал</p></div><p class="vacancy-card__description">Lorem ipsum dolor sit amet consectetur. Eu augue fames felis ultrices. Scelerisque ipsum nulla tempor vitae. Nec eu dui feugiat orci dui amet consectetur tortor sem.</p><a class="btn btn--default btn--m vacancy-card__button" href="#">Подробнее</a></div>
                </article>
                <article class="vacancy-card">
                  <img class="vacancy-card__pattern" src="../images/svg/vacancy-pattern.svg" alt="" />
                  <div class="vacancy-card__content"><div class="vacancy-card__heading"><h2 class="vacancy-card__title">Инженер-техник</h2><p class="vacancy-card__category">Административный персонал</p></div><p class="vacancy-card__description">Lorem ipsum dolor sit amet consectetur. Eu augue fames felis ultrices. Scelerisque ipsum nulla tempor vitae. Nec eu dui feugiat orci dui amet consectetur tortor sem.</p><a class="btn btn--default btn--m vacancy-card__button" href="#">Подробнее</a></div>
                </article>
              </div>
            </section>
          </div>

          <section class="vacancy-documents">
            <h2 class="vacancy-documents__title">Основные документы</h2>
            {% include "components/document-list.njk" %}
          </section>
        </div>
      </main>

{% include "components/footer.njk" %}
    </div>

    <div class="mobile-filter-panel" id="vacancy-filter-panel" data-filter-panel aria-hidden="true">
      <aside class="mobile-filter-panel__drawer" aria-label="Фильтры вакансий">
        <header class="mobile-filter-panel__header"><h2 class="mobile-filter-panel__title">Фильтры</h2><button class="mobile-filter-panel__close" type="button" data-close-filter-panel aria-label="Закрыть фильтры"><img src="../images/svg/close-white.svg" alt="" /></button></header>
        <form class="mobile-filter-panel__form" method="get">
          <details open><summary>категория</summary><div class="catalog-filter-group__options"><label class="catalog-filter-option"><input type="checkbox" name="category[]" value="academic" />Научно-педагогические работники</label><label class="catalog-filter-option"><input type="checkbox" name="category[]" value="administrative" checked />Административный персонал</label></div></details>
          <details open><summary>опыт работы</summary><div class="catalog-filter-group__options"><label class="catalog-filter-option"><input type="radio" name="experience" value="none" />без опыта</label><label class="catalog-filter-option"><input type="radio" name="experience" value="1-plus" checked />от 1 года</label><label class="catalog-filter-option"><input type="radio" name="experience" value="3-6" />от 3 до 6 лет</label><label class="catalog-filter-option"><input type="radio" name="experience" value="6-plus" />более 6 лет</label></div></details>
          <details open><summary>тип занятости</summary><div class="catalog-filter-group__options"><label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="full" checked />полная</label><label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="internship" />стажировка</label><label class="catalog-filter-option"><input type="checkbox" name="employment[]" value="part" />частичная</label></div></details>
          <details><summary>формат работы</summary><div class="catalog-filter-group__options"><label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="office" />Офис</label><label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="hybrid" />Гибрид</label><label class="catalog-filter-option"><input type="checkbox" name="work_format[]" value="remote" />Удалённо</label></div></details>
          <div class="catalog-filters__actions"><button class="btn btn--default btn--m catalog-filters__apply" type="submit">Применить</button><button class="catalog-filters__reset" type="reset">Сбросить</button></div>
        </form>
      </aside>
    </div>
    {% include "components/cookie-banner.njk" %}
  {% endblock %}
